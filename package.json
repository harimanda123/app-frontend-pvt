{
  "name": "app-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck:workspaces": "tsc -p tsconfig.workspaces.json",
    "test": "turbo run test",
    "test:e2e": "npm run test:e2e --workspace=apps/custom",
    "worker:documents": "npm run worker:documents --workspace=apps/custom",
    "openapi": "npm run openapi --workspace=apps/custom",
    "seed": "npm run db:seed --workspace=packages/db"
  },
  "devDependencies": {
    "@types/node": "^20",
    "turbo": "^2.10.11",
    "typescript": "^5"
  }
}
