model AccountMemory {
  id                 String                   @id @default(cuid())
  accountId          String
  type               AccountMemoryType
  subjectType        AccountMemorySubjectType
  subjectId          String?
  content            String
  confidence         Float                    @default(1.0)
  validFrom          DateTime                 @default(now())
  validUntil         DateTime?
  sourceType         AccountMemorySourceType
  sourceId           String?
  supersedesMemoryId String?
  /// Legacy plain-array embedding, kept for backward-compatible reads/exports.
  /// Retrieval no longer scans this column -- see embeddingVector.
  embedding          Float[]                  @default([])
  /// Superseded by contentTsv (real Postgres FTS). Kept only so old rows that
  /// predate the generated tsvector column still have a lowercase fallback.
  searchVector       String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  /// pgvector column queried by findVectorMatches via the `<=>` operator.
  /// Unsupported because Prisma Client has no native vector type; written via
  /// raw SQL in MemoryRepository.createMemory, indexed with HNSW (see migration).
  embeddingVector    Unsupported("vector")?
  /// Generated column (STORED, from `content`) backing real Postgres full-text
  /// search; GIN-indexed. Populated by Postgres on write, never by the app.
  /// The dbgenerated default below mirrors the migration's GENERATED ALWAYS AS
  /// STORED expression so `prisma migrate diff` sees this column as in sync --
  /// it does not (and must not) make Prisma try to manage the column itself;
  /// `migrate dev` cannot create a STORED generated column, only a raw migration can.
  contentTsv         Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, ((COALESCE(content, ''::text) || ' '::text) || COALESCE(\"subjectId\", ''::text)))"))
  account            Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  supersedesMemory   AccountMemory?           @relation("MemorySupersession", fields: [supersedesMemoryId], references: [id])
  supersededBy       AccountMemory[]          @relation("MemorySupersession")
  evidence           MemoryEvidence[]

  @@index([accountId])
  @@index([accountId, type])
  @@index([accountId, subjectType, subjectId])
  @@index([supersedesMemoryId])
}

model MemoryEvidence {
  id         String                  @id @default(cuid())
  accountId  String
  memoryId   String
  sourceType AccountMemorySourceType
  sourceId   String?
  excerpt    String
  confidence Float                   @default(1.0)
  createdAt  DateTime                @default(now())
  account    Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  memory     AccountMemory           @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([memoryId])
}

model IntegrationConfig {
  id               String              @id @default(cuid())
  accountId        String
