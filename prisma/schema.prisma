/// countries -- country master. cyIndEmbargoed/cyIndBoycotted are country-level
/// flags; cyIndGlds gates the generic-LD embargo path; cyIndLds/cyIndDps gate
/// license/party screening eligibility.
model Country {
  cySeq          Int       @id @map("cy_seq")
  cyId           String    @map("cy_id")
  cyName         String?   @map("cy_name")
  cyShortName    String?   @map("cy_shrt_name")
  cyIndEmbargoed String?   @map("cy_ind_embargoed")
  cyIndBoycotted String?   @map("cy_ind_boycotted")
  cyIndDps       String?   @map("cy_ind_dps")
  cyIndLds       String?   @map("cy_ind_lds")
  cyIndEms       String?   @map("cy_ind_ems")
  cyIndGlds      String?   @map("CY_IND_GLDS")
  cyDtCrt        DateTime? @map("cy_dt_crt")
  cyDtUpd        DateTime? @map("cy_dt_upd")

  @@index([cyId])
  @@index([cyName])
  @@map("countries")
}

