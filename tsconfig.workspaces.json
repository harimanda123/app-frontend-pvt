{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": false,
    "paths": {
      "@/*": ["./apps/custom/src/*"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "apps/custom/src/**/*.ts",
    "apps/custom/src/**/*.tsx",
    "apps/custom/tests/**/*.ts",
    "apps/custom/e2e/**/*.ts",
    "apps/custom/playwright.config.ts",
    "apps/custom/next.config.ts"
  ],
  "exclude": [
    "node_modules",
    "infrastructure",
    "apps/custom/scripts/**",
    "packages/db/prisma/seeds/**",
    "packages/db/prisma/seed.ts",
    "packages/db/prisma/seed-deadlines.ts",
    "packages/db/prisma/seed-f06.ts",
    "packages/db/prisma/import-hts.ts",
    "packages/db/prisma/import-hts-local.ts"
  ],
  "references": []
}
